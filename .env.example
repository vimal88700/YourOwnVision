# ============================================================
# YourOwnVision / WHAT HAPPENS?
# Local environment template
#
# IMPORTANT:
# - Copy this file to .env for local development.
# - NEVER commit .env.
# - NEVER put real secrets in .env.example.
# - Production secrets belong in Render Environment Variables.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

ENVIRONMENT=development

LOG_LEVEL=INFO


# ============================================================
# TELEGRAM
# ============================================================

# Get this from BotFather.
TELEGRAM_BOT_TOKEN=

# Random secret used by Telegram when calling the webhook.
# For local development you can generate one with:
#
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS address of the deployed Render service.
#
# Example:
# https://your-service-name.onrender.com
#
PUBLIC_BASE_URL=

# Telegram webhook endpoint.
TELEGRAM_WEBHOOK_PATH=/telegram/webhook


# ============================================================
# GEMINI
# ============================================================

# Google Gemini API key.
GEMINI_API_KEY=

# Preferred story-generation model for this project.
GEMINI_MODEL=gemini-3.8-flash


# ============================================================
# SUPABASE
# ============================================================

# Example:
# https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key.
#
# WARNING:
# This is a SECRET.
# Never expose it to Telegram, browser JavaScript,
# frontend code, GitHub, or public documentation.
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================
# ADMIN USERS
# ============================================================

# Optional comma-separated Telegram numeric user IDs.
#
# Example:
# ADMIN_USER_IDS=123456789,987654321
#
ADMIN_USER_IDS=


# ============================================================
# GAME SETTINGS
# ============================================================

# How long the lobby remains open.
GAME_JOIN_SECONDS=45

# Default decision timer.
DEFAULT_DECISION_SECONDS=35

# Engine safety limits for generated story timers.
MINIMUM_DECISION_SECONDS=15
MAXIMUM_DECISION_SECONDS=900

# Minimum and maximum number of human players.
MINIMUM_PLAYERS=1
MAXIMUM_PLAYERS=4

# Maximum number of attempts allowed when Gemini generates
# a story that fails structural validation.
MAX_STORY_GENERATION_ATTEMPTS=5
